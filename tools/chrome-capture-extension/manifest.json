{
  "manifest_version": 3,
  "name": "ThatzFit Extension Dev",
  "description": "Development extension that injects ThatzFit UI and bridges visible-tab capture.",
  "version": "0.1.0",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": [
    "https://demo.thatz.fit/*",
    "https://cdn.thatz.fit/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Open ThatzFit"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://demo.thatz.fit/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
